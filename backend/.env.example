NODE_ENV=development
PORT=3000

# String de conexão do PostgreSQL (em produção: Azure Database for PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/c4diagrams
# true em produção: conexão cifrada, validando o certificado do servidor
DATABASE_SSL=false

# Google Gemini API
GEMINI_API_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Resend
RESEND_API_KEY=chave_api_resend
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173

# Produção (definidas na imagem Docker / no App Service)
# Pasta com o frontend compilado, servido pela própria API
# STATIC_DIR=/app/public
# Monitoramento: New Relic (sem a chave, a telemetria fica desligada)
# NEW_RELIC_LICENSE_KEY=
